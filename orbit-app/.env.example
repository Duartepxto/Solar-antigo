# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=orbit
ORBIT_BIND_ADDRESS=127.0.0.1
ORBIT_HTTP_PORT=8080
# Leave empty to use http://localhost:${ORBIT_HTTP_PORT:-8080}.
ORBIT_PUBLIC_URL=
# Leave empty to inherit ORBIT_PUBLIC_URL.
ORBIT_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set ORBIT_PUBLIC_URL to https:// followed by the same hostname.
# Requires ORBIT_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
ORBIT_HTTPS_HOST=
ORBIT_BASE_IMAGE=ghcr.io/dragonqlf/orbit:latest
ORBIT_LOCAL_IMAGE=orbit-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
ORBIT_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
ORBIT_DATA_EXTERNAL=false
