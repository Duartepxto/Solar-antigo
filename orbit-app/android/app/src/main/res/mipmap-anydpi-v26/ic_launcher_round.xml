<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: the system masks the layers to whatever shape the launcher
  uses, so there is one definition and no per-density bitmaps. The foreground is
  Orbit's icon art on clear (scripts/make-app-icons.mjs).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
