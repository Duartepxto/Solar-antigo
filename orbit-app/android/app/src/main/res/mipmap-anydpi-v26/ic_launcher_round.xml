<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: the system masks the layers to whatever shape the launcher
  uses, so there is one Solar vector definition and no per-density bitmaps.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/ic_solar_launcher" />
    <monochrome android:drawable="@drawable/ic_solar_launcher" />
</adaptive-icon>
