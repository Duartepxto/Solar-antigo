<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: the system masks the layers to whatever shape the launcher
  uses. Solar's vector foreground stays crisp at every density; the
  launcher supplies the dark background and optional monochrome tint.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/ic_solar_launcher" />
    <monochrome android:drawable="@drawable/ic_solar_launcher" />
</adaptive-icon>
